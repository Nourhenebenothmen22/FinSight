# =============================================================================
# FinSight - Environment Configuration Example
# Copy to .env and fill in values. Never commit .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=FinSight
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3002
BACKEND_INTERNAL_URL=http://api:8000
CORS_ORIGINS=["http://localhost:3002"]

# -----------------------------------------------------------------------------
# Security (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30
ORG_INVITATION_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=finsight_refresh_token
AUTH_COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PROFILE=auto  # auto -> relaxed_dev in development, strict in test/staging/production
RATE_LIMIT_DEV_BURST=20
RATE_LIMIT_DEV_BACKOFF_SECONDS=5
# AUTH_LOGIN_BACKOFF_STEPS=[5,15,60,300]
# AUTH_LOGIN_DISTRIBUTED_EMAIL_LIMIT=30
# TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]  # Restrict to reverse proxy IPs in staging/production

# -----------------------------------------------------------------------------
# PostgreSQL (transactional data, LangGraph checkpoints, audit)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=finsight
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=finsight
POSTGRES_SSL_MODE=disable  # require in production

# -----------------------------------------------------------------------------
# Redis (cache, quotas, rate limits, queues, provider cooldowns)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # optional, empty for local dev
REDIS_DB=0

# -----------------------------------------------------------------------------
# Qdrant (vector search for document chunks)
# -----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=  # optional for local dev
QDRANT_COLLECTION_PREFIX=finsight

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage - Garage (local) / S3 or R2 (production)
# Generate Garage keys locally:
#   GARAGE_RPC_SECRET=$(openssl rand -hex 32)
#   GARAGE_ADMIN_TOKEN=$(openssl rand -hex 32)
#   S3_ACCESS_KEY="GK$(openssl rand -hex 12)"
#   S3_SECRET_KEY=$(openssl rand -hex 32)
# -----------------------------------------------------------------------------
S3_HOST=garage
S3_PORT=3900
S3_ADMIN_PORT=3903
S3_ACCESS_KEY=GK000000000000000000000000
S3_SECRET_KEY=CHANGE_ME_64_HEX_CHARS_GENERATED_WITH_OPENSSL_RAND_HEX_32
S3_BUCKET_DOCUMENTS=finsight-documents
S3_BUCKET_REPORTS=finsight-reports
S3_REGION=us-east-1
S3_SECURE=false  # true in production with TLS
GARAGE_RPC_SECRET=CHANGE_ME_64_HEX_CHARS_GENERATED_WITH_OPENSSL_RAND_HEX_32
GARAGE_ADMIN_TOKEN=CHANGE_ME_64_HEX_CHARS_GENERATED_WITH_OPENSSL_RAND_HEX_32

# -----------------------------------------------------------------------------
# LLM Providers (configure as needed - at least one required for F7+)
# -----------------------------------------------------------------------------
# Groq (fast, free tier available)
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-70b-versatile

# Google Gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# OpenRouter (access to many models)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Mistral
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-large-latest

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=llama3.1-70b

# Hugging Face Inference
HF_API_KEY=
HF_DEFAULT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Ollama (local fallback - optional)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=llama3.1:70b

# LLM Router Configuration (role -> provider/model mapping)
LLM_ROUTER_CONFIG_PATH=./config/llm_router.yaml

# -----------------------------------------------------------------------------
# External Data Providers (F8, F9)
# -----------------------------------------------------------------------------
# Yahoo Finance (yfinance) - no key needed
# Alpha Vantage
ALPHA_VANTAGE_API_KEY=

# News API
NEWS_API_KEY=

# FinBERT (sentiment) - local model path or HF model ID
FINBERT_MODEL=ProsusAI/finbert

# -----------------------------------------------------------------------------
# Billing (F14) - TEST MODE ONLY during development
# -----------------------------------------------------------------------------
BILLING_PROVIDER=stripe  # or paddle, lemonsqueezy
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_API_VERSION=2024-04-10

# -----------------------------------------------------------------------------
# LangSmith (observability - F19)
# -----------------------------------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
# Email (for verification, password reset, notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@finsight.local
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_BASE_URL=http://localhost:3002/verify-email
PASSWORD_RESET_BASE_URL=http://localhost:3002/reset-password
INVITATION_ACCEPT_BASE_URL=http://localhost:3002/invitations/accept

# -----------------------------------------------------------------------------
# Google OAuth (F1)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Demo Request Notifications (F17)
# -----------------------------------------------------------------------------
DEMO_REQUEST_WEBHOOK_URL=
DEMO_REQUEST_EMAIL_TO=

# -----------------------------------------------------------------------------
# Admin (F18)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@finsight.local
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_RUN
