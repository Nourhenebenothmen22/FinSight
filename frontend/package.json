{
  "name": "finsight-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src --dir tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "14.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "axios": "1.7.0",
    "recharts": "2.12.0",
    "zod": "3.23.0",
    "clsx": "2.1.0",
    "tailwind-merge": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "typescript": "5.4.5",
    "tailwindcss": "3.4.0",
    "postcss": "8.4.38",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.0",
    "prettier": "3.2.0",
    "prettier-plugin-tailwindcss": "0.5.0",
    "vitest": "1.5.0",
    "@testing-library/react": "14.2.0",
    "@testing-library/jest-dom": "6.4.0",
    "jsdom": "24.0.0",
    "@vitejs/plugin-react": "4.2.0"
  }
